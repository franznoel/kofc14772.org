# Use Neon's pooled connection string for the deployed application.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# Added when Neon Auth is provisioned.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Stripe Connect (server-side only; never prefix these with NEXT_PUBLIC_).
STRIPE_SECRET_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=
STRIPE_MEMBERSHIP_DUES_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_ORIGIN=https://stgenknights.com
# Optional platform identifier or context for a future Stripe adapter.
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_CONTEXT=
